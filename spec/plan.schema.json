{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/PAthfinderK1ng/ai-scene-bridge/spec/plan.schema.json",
  "title": "场景程序（plan）v2",
  "description": "AI 写的场景程序（docs/06 §2）。AI 自己搭结构：形体组成组，组可以嵌套、重复，相对彼此定位；地形用雕刻操作组合。坐标规则：局部尺寸与偏移可以写（size_m / offset_m / rotate_deg / spacing_m / radius_m / path_m / polygon_m 都是米、都在父组的局部坐标里：x 东、z 南），全局摆放交给引擎：根节点只能用 at 锚点（site.N、hall.top、towers[2]…）。引擎（medium/engine/plan.js + program.js）负责落地 / 避让 / 路由 / 检查，同 plan + seed → 同结果。x-ui 给界面生成旋钮：label 中文名，kind number|enum|text|ref|refs|dir|bool|color|pair|triple|size|offset|anchor|node|nodes|tags|palette|rooms|links，step / unit / min / max 给数字，options 给枚举中文，when 只在某些 type / op / pattern / style / stratum 下显示，summary 出现在场景树那一行（short 是格式：{v} 值、{o} 枚举中文、{r} 引用名、{v0}{v1}{v2} 分量），hidden 不出旋钮。x-groups 列出右栏的分组；x-defaults 按 op / type 给默认值；x-node-classes 给「＋」菜单分类；x-size 给每种 type 的 size_m 各分量含义。",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "site", "nodes"],
  "x-version": 2,
  "x-groups": [
    { "key": "terrain", "label": "地形", "def": "terrain_op", "min": 0, "max": 24, "type_field": "op" },
    { "key": "nodes", "label": "场景", "def": "node", "min": 1, "max": 40, "type_field": "type", "tree": true },
    { "key": "relations", "label": "关系", "def": "relation", "min": 0, "max": 12, "type_field": "type" },
    { "key": "look", "label": "外观", "def": null, "min": 0, "max": 0, "fields": ["lighting", "palette", "mood"] }
  ],
  "x-node-classes": [
    { "key": "shape", "label": "形体", "types": ["box", "cylinder", "cone", "dome", "pyramid", "wedge", "arch", "torus", "sphere", "prism"] },
    { "key": "part", "label": "建筑件", "types": ["building", "tower", "wall", "courtyard", "stairs", "platform", "column", "gate", "statue", "tree", "rock", "crystal", "island", "water"] },
    { "key": "compose", "label": "组合", "types": ["group", "repeat"] },
    { "key": "link", "label": "连接", "types": ["link"] },
    { "key": "generator", "label": "生成器", "types": ["terraces", "scatter_houses", "space", "grove", "field"] }
  ],
  "x-size": {
    "box": ["宽", "高", "深"], "wedge": ["宽", "高", "深"], "pyramid": ["宽", "高", "深"], "arch": ["宽", "高", "厚"],
    "cylinder": ["直径", "高", "南北直径"], "cone": ["直径", "高", "南北直径"], "dome": ["直径", "高", "南北直径"], "sphere": ["直径", "高", "南北直径"], "torus": ["直径", "管粗", "南北直径"], "prism": ["直径", "高", "南北直径"],
    "building": ["宽", "高", "深"], "tower": ["直径", "高", "南北直径"], "wall": ["长", "高", "厚"], "courtyard": ["宽", "深"], "stairs": ["宽", "高", "长"], "platform": ["宽", "高", "深"], "column": ["直径", "高"], "gate": ["宽", "高", "厚"], "statue": ["宽", "高", "深"], "tree": ["冠径", "高"], "rock": ["宽", "高", "深"], "crystal": ["直径", "高"], "island": ["宽", "厚", "深"], "water": ["宽", "深"],
    "terraces": ["长", "宽"], "scatter_houses": ["宽", "深"], "grove": ["宽", "深"], "field": ["宽", "深"], "space": ["宽", "深"], "group": [], "repeat": [], "link": []
  },
  "x-defaults": {
    "terrain": {
      "raise": { "label": "高地", "shape": "circle", "size_m": [60, 60], "height_m": 12, "edge": "slope" },
      "lower": { "label": "洼地", "shape": "circle", "size_m": [40, 40], "depth_m": 4, "edge": "slope" },
      "flatten": { "label": "平地", "shape": "circle", "size_m": [40, 40], "edge": "slope" },
      "terrace": { "label": "台阶化", "shape": "circle", "size_m": [80, 80], "step_h_m": 3 },
      "ramp": { "label": "坡道", "width_m": 8 },
      "carve": { "label": "沟", "width_m": 10, "depth_m": 6, "edge": "slope" },
      "lake": { "label": "湖", "shape": "ellipse", "size_m": [70, 50], "depth_m": 4 },
      "river": { "label": "河", "width_m": 10, "depth_m": 3 },
      "cliff": { "label": "崖", "shape": "rect", "size_m": [60, 20], "height_m": 16, "edge": "cliff" },
      "dune": { "label": "沙丘", "amplitude_m": 3, "scale_m": 30 },
      "noise": { "label": "起伏", "amplitude_m": 2, "scale_m": 40 }
    },
    "nodes": {
      "box": { "label": "方块", "size_m": [6, 6, 6] },
      "cylinder": { "label": "圆柱", "size_m": [6, 8] },
      "cone": { "label": "圆锥", "size_m": [6, 8] },
      "dome": { "label": "穹顶", "size_m": [10, 5] },
      "pyramid": { "label": "金字塔", "size_m": [16, 10, 16] },
      "wedge": { "label": "楔", "size_m": [6, 3, 6] },
      "arch": { "label": "拱", "size_m": [8, 8, 2] },
      "torus": { "label": "环", "size_m": [12, 2] },
      "sphere": { "label": "球", "size_m": [6, 6] },
      "prism": { "label": "棱柱", "size_m": [6, 8], "sides": 6 },
      "building": { "label": "房子", "size_m": [12, 8, 10], "roof": "gable", "floors": 2 },
      "tower": { "label": "塔", "size_m": [6, 20], "roof": "spire", "floors": 5 },
      "wall": { "label": "墙", "size_m": [20, 4, 1] },
      "courtyard": { "label": "院", "size_m": [24, 20], "wall_h_m": 4, "gate": "S" },
      "stairs": { "label": "台阶", "size_m": [4, 3, 8] },
      "platform": { "label": "平台", "size_m": [12, 1, 12] },
      "column": { "label": "柱", "size_m": [1, 6] },
      "gate": { "label": "门", "size_m": [6, 7, 2] },
      "statue": { "label": "像", "size_m": [2, 5, 2] },
      "tree": { "label": "树", "size_m": [5, 8] },
      "rock": { "label": "岩", "size_m": [4, 3, 4] },
      "crystal": { "label": "晶体", "size_m": [2, 6] },
      "island": { "label": "浮岛", "size_m": [20, 8, 20], "elev_m": 20 },
      "water": { "label": "水池", "size_m": [12, 8] },
      "group": { "label": "组" },
      "repeat": { "label": "重复", "pattern": "radial", "count": 6, "radius_m": 20 },
      "link": { "label": "路", "style": "path" },
      "terraces": { "label": "台地", "form": "slope", "size_m": [80, 80], "steps": 4 },
      "scatter_houses": { "label": "民居", "size_m": [60, 60], "density": 1 },
      "space": { "label": "地下室", "stratum": "underground", "layout": "chamber", "size_m": 20, "depth_m": 8 },
      "grove": { "label": "树林", "size_m": [40, 40], "density": 1 },
      "field": { "label": "田", "size_m": [40, 30] }
    },
    "relations": { "visible_from": {}, "reachable": {}, "adjacent": {}, "above": {}, "below": {}, "behind": {}, "between": {}, "far_from": {}, "faces": {} }
  },
  "properties": {
    "name": { "type": "string", "maxLength": 16, "x-ui": { "label": "名字", "kind": "text" } },
    "concept": { "type": "string", "maxLength": 120, "description": "一句话的空间概念（三张卡各不相同的那个想法）", "x-ui": { "label": "概念", "kind": "text" } },
    "key_structures": { "type": "array", "maxItems": 6, "items": { "type": "string", "maxLength": 24 }, "description": "关键结构（构思阶段写的，最多 6 条）", "x-ui": { "label": "关键结构", "kind": "tags" } },
    "one_liner": { "type": "string", "maxLength": 120, "description": "旧字段（v4），等同 concept", "x-ui": { "hidden": true } },
    "site": { "$ref": "#/definitions/site" },
    "terrain": { "type": "array", "maxItems": 24, "items": { "$ref": "#/definitions/terrain_op" }, "description": "AI 写的 ≤ 16 个；人在图上手调高度（heightEdit）加的也在这里，合计 ≤ 24" },
    "marks": { "type": "array", "maxItems": 32, "items": { "$ref": "#/definitions/mark" }, "description": "人画的标记（docs/07 §1.1）：圈的一块（area）、画的一笔（trace）、点的一个位置（pin）。坐标是人给的（相对场地中心，x 东、z 南，米），AI 不写坐标，只拿 id 当锚点：at: mark_1（area 的中心 / pin 的点 / trace 的中点）、area: mark_1（散布 / 生成器 / 地形操作的范围）、along: mark_2（沿线重复 / 连接 / 开沟）。不出体块，不参与碰撞", "x-ui": { "hidden": true } },
    "nodes": { "type": "array", "minItems": 1, "maxItems": 40, "items": { "$ref": "#/definitions/node" } },
    "spawn": { "$ref": "#/definitions/spawn" },
    "relations": { "type": "array", "maxItems": 12, "items": { "$ref": "#/definitions/relation" } },
    "palette": { "type": "array", "maxItems": 8, "items": { "$ref": "#/definitions/palette_entry" }, "x-ui": { "label": "色板", "kind": "palette" } },
    "lighting": { "$ref": "#/definitions/lighting" },
    "mood": { "type": "array", "maxItems": 6, "items": { "type": "string", "maxLength": 8 }, "x-ui": { "label": "气氛", "kind": "tags" } },
    "locks": { "type": "array", "items": { "$ref": "#/definitions/id" }, "description": "人锁住的节点 id（换一批时不动）。只由界面写。", "x-ui": { "hidden": true } }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$", "description": "英文小写短名，被引用的才必须写" },
    "ref": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}(\\[[0-9]{1,3}\\])?$", "description": "引用：site / spawn / 节点或地形操作的 id / 重复的第 k 个实例 id[k]" },
    "anchor": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}(\\[([0-9]{1,3}|k)\\])?(\\.(top|bottom|center|C|N|NE|E|SE|S|SW|W|NW|inner|outer|start|mid|end|left|right))?$",
      "description": "锚点（不是坐标）：site.<C|N|NE|E|SE|S|SW|W|NW>（场地中心 / 边）、<id>（它的中心）、<id>.<top|bottom|center|N|S|E|W|NE|…|inner|outer|start|mid|end|left|right>（沟 / 河 / 坡道这类线形地形：方位后缀 = 和该方位同侧的岸，left / right = 顺着 from → to 走的左 / 右岸）、<repeat id>[k]（第 k 个实例，从 0 数）、spawn、<mark id>（人画的标记：area 的中心 / pin 的点 / trace 的中点；area 也认 .N / .top 等后缀）。一组连接（repeat 的 child 是 link）里写 <repeat id> 或 <repeat id>[k]（字母 k）= 第 k 条连到那个重复的第 k 个实例，center = 这个重复的中心"
    },
    "label": { "type": "string", "minLength": 1, "maxLength": 16 },
    "dir": { "type": "string", "enum": ["C", "N", "NE", "E", "SE", "S", "SW", "W", "NW"] },
    "offset": { "type": "array", "items": { "type": "number", "minimum": -500, "maximum": 500 }, "minItems": 2, "maxItems": 3, "description": "在父组局部坐标里的偏移 [dx, dz] 或 [dx, dy, dz]（米，x 东、z 南、y 上）" },
    "pair": { "type": "array", "items": { "type": "number", "minimum": 0.5, "maximum": 600 }, "minItems": 2, "maxItems": 2 },
    "local_pts": { "type": "array", "minItems": 2, "maxItems": 24, "items": { "type": "array", "items": { "type": "number", "minimum": -500, "maximum": 500 }, "minItems": 2, "maxItems": 2 }, "description": "局部折线 / 多边形 [[x, z], …]（米，相对 at 锚点，x 东、z 南）" },
    "site_pt": { "type": "array", "items": { "type": "number", "minimum": -300, "maximum": 300 }, "minItems": 2, "maxItems": 2, "description": "人给的一个点 [x, z]（米，相对场地中心，x 东、z 南）" },
    "site_pts": { "type": "array", "minItems": 2, "maxItems": 64, "items": { "$ref": "#/definitions/site_pt" }, "description": "人画的折线 / 多边形 [[x, z], …]（米，相对场地中心）" },

    "mark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "description": "人画的标记（只由界面写；AI 只引用 id）。area = 圈的一块（polygon_m ≥ 3 点）；trace = 画的一笔（path_m ≥ 2 点）；pin = 点的一个位置（point_m）",
      "properties": {
        "id": { "$ref": "#/definitions/id", "x-ui": { "hidden": true } },
        "type": { "type": "string", "enum": ["area", "trace", "pin"], "x-ui": { "label": "标记", "kind": "enum", "summary": true, "short": "{o}", "options": { "area": "圈选", "trace": "手绘线", "pin": "图钉" } } },
        "label": { "$ref": "#/definitions/label", "x-ui": { "label": "名字", "kind": "text" } },
        "polygon_m": { "$ref": "#/definitions/site_pts", "x-ui": { "hidden": true } },
        "path_m": { "$ref": "#/definitions/site_pts", "x-ui": { "hidden": true } },
        "point_m": { "$ref": "#/definitions/site_pt", "x-ui": { "hidden": true } }
      }
    },

    "site": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size_m": {
          "oneOf": [ { "type": "number", "minimum": 60, "maximum": 400 }, { "type": "array", "items": { "type": "number", "minimum": 60, "maximum": 400 }, "minItems": 2, "maxItems": 2 } ],
          "default": [160, 160],
          "x-ui": { "label": "场地", "kind": "pair", "step": 10, "unit": "m", "parts": ["东西", "南北"], "summary": true, "short": "{v0}×{v1} m" }
        },
        "ground": { "type": "string", "enum": ["flat", "rolling", "hills", "mountain", "canyon", "lake", "island", "coast", "desert", "cavern", "sky"], "default": "flat",
          "description": "基础形态：flat 平地；rolling 缓坡起伏；hills 丘陵；mountain 中间高；canyon 高原中间一道峡谷（南北走）；lake 中间低、带湖；island 中间陆地、四周海；coast 北陆南海；desert 沙丘；cavern 四周岩壁围住的洞底；sky 没有地面（远处云海），只有浮岛",
          "x-ui": { "label": "基础地形", "kind": "enum", "summary": true, "short": "{o}", "options": { "flat": "平地", "rolling": "缓坡", "hills": "丘陵", "mountain": "山", "canyon": "峡谷", "lake": "湖", "island": "海岛", "coast": "海岸", "desert": "沙漠", "cavern": "洞穴", "sky": "天空" } } },
        "relief_m": { "type": "number", "minimum": 0, "maximum": 80, "description": "基础形态的高差（米）；不写按 ground 默认", "x-ui": { "label": "高差", "kind": "number", "step": 1, "unit": "m" } },
        "layer_m": { "type": "number", "minimum": 2, "maximum": 6, "default": 3, "description": "一层多高（台地、剖面刻度用）", "x-ui": { "label": "每层高", "kind": "number", "step": 0.5, "unit": "m" } }
      }
    },

    "terrain_op": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op"],
      "description": "地形雕刻操作，按顺序作用在高度场上。合成：raise / lower / cliff = 抬到 / 压到（锚点处原高度 ± height / depth，平顶；edge round 时是相加的圆丘）；flatten / ramp = 覆盖（flatten 削到锚点处高度 + height_m − depth_m；target at_point = 取锚点那一点（图钉）原来的高度）；carve / river / dune / noise = 相加；lake = 压到 + 水面；terrace = 把已有坡面台阶化。台阶化的面登记成台地。只能锚到 site.*、前面的地形操作和人画的标记（marks）。area: <圈选标记> = 形状就用那一块；along: <手绘线标记> = 沟 / 河 / 坡道沿那条线。",
      "properties": {
        "id": { "$ref": "#/definitions/id", "x-ui": { "hidden": true } },
        "op": { "type": "string", "enum": ["raise", "lower", "flatten", "terrace", "ramp", "carve", "lake", "river", "cliff", "dune", "noise"],
          "x-ui": { "label": "操作", "kind": "enum", "summary": true, "short": "{o}", "options": { "raise": "抬起", "lower": "压低", "flatten": "削平", "terrace": "台阶化", "ramp": "坡道", "carve": "开沟", "lake": "成湖", "river": "河", "cliff": "立崖", "dune": "沙丘", "noise": "起伏" } } },
        "label": { "$ref": "#/definitions/label", "x-ui": { "label": "名字", "kind": "text" } },
        "at": { "$ref": "#/definitions/anchor", "x-ui": { "label": "在哪", "kind": "anchor", "ref": ["site", "terrain", "marks"], "summary": true, "short": "@{r}" } },
        "area": { "$ref": "#/definitions/ref", "description": "用人圈的一块（area 标记）当形状（不用 shape / size_m）", "x-ui": { "label": "范围", "kind": "ref", "ref": ["marks"], "when": { "op": ["raise", "lower", "flatten", "terrace", "lake", "cliff", "dune", "noise"] } } },
        "along": { "$ref": "#/definitions/ref", "description": "沿人画的一笔（trace 标记）开沟 / 成河 / 做坡道", "x-ui": { "label": "沿着", "kind": "ref", "ref": ["marks"], "when": { "op": ["ramp", "carve", "river"] } } },
        "target": { "type": "string", "enum": ["center", "at_point"], "description": "削平到哪的高度：center = 操作中心（缺省）；at_point = 锚点那一点（图钉）原来的地面高", "x-ui": { "label": "削到", "kind": "enum", "options": { "center": "中心高度", "at_point": "图钉处高度" }, "when": { "op": ["flatten"] } } },
        "offset_m": { "$ref": "#/definitions/offset", "x-ui": { "label": "偏移", "kind": "offset", "step": 1, "unit": "m" } },
        "shape": { "type": "string", "enum": ["circle", "ellipse", "rect", "ring", "line", "polygon"],
          "x-ui": { "label": "形状", "kind": "enum", "options": { "circle": "圆", "ellipse": "椭圆", "rect": "矩形", "ring": "环", "line": "线", "polygon": "多边形" }, "when": { "op": ["raise", "lower", "flatten", "terrace", "lake", "cliff", "dune", "noise"] } } },
        "size_m": { "$ref": "#/definitions/pair", "description": "[东西, 南北]（米，转 rotate_deg 之前）；圆取较小的那个作直径", "x-ui": { "label": "尺寸", "kind": "pair", "step": 2, "unit": "m", "parts": ["东西", "南北"], "summary": true, "short": "{v0}×{v1} m", "when": { "op": ["raise", "lower", "flatten", "terrace", "lake", "cliff", "dune", "noise"] } } },
        "polygon_m": { "$ref": "#/definitions/local_pts", "x-ui": { "hidden": true } },
        "path_m": { "$ref": "#/definitions/local_pts", "x-ui": { "hidden": true } },
        "from": { "$ref": "#/definitions/anchor", "x-ui": { "label": "从", "kind": "anchor", "ref": ["site", "terrain"], "when": { "op": ["ramp", "carve", "river"] } } },
        "to": { "$ref": "#/definitions/anchor", "x-ui": { "label": "到", "kind": "anchor", "ref": ["site", "terrain"], "when": { "op": ["ramp", "carve", "river"] } } },
        "rotate_deg": { "type": "number", "minimum": -360, "maximum": 360, "x-ui": { "label": "转", "kind": "number", "step": 15, "unit": "°" } },
        "height_m": { "type": "number", "minimum": 0, "maximum": 150, "x-ui": { "label": "高", "kind": "number", "step": 1, "unit": "m", "summary": true, "short": "高 {v} m", "when": { "op": ["raise", "cliff", "flatten"] } } },
        "depth_m": { "type": "number", "minimum": 0, "maximum": 80, "x-ui": { "label": "深", "kind": "number", "step": 1, "unit": "m", "summary": true, "short": "深 {v} m", "when": { "op": ["lower", "carve", "lake", "river", "flatten"] } } },
        "edge": { "type": "string", "enum": ["slope", "cliff", "terraced", "round"], "x-ui": { "label": "边", "kind": "enum", "options": { "slope": "缓坡", "cliff": "陡崖", "terraced": "台阶", "round": "圆丘" }, "when": { "op": ["raise", "lower", "flatten", "carve", "cliff", "lake"] } } },
