{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/PAthfinderK1ng/ai-scene-bridge/spec/plan.schema.json",
  "title": "场景构成图（plan）v4",
  "description": "AI 输出的场景构成图（docs/05 §2）。没有任何绝对坐标：位置全部用相对关系（at / place），尺寸用米。引擎（medium/engine/plan.js）把它编译成 SID。x-ui 是给界面生成旋钮的提示：label 中文名，kind number|enum|text|ref|refs|dir|bool|color|pair|triple，step / unit / min / max 给数字旋钮，options 给枚举的中文，ref 给引用可选的组，when 只在某些 type / form / layout 下显示，summary 出现在清单那一行的关键值里（short 是格式，{v} 为值），hidden 不出旋钮。x-groups 列出清单的分组；x-defaults 按 type / form 给默认值（plan.js 的 normalizePlan 与「＋ 加一个」都用它）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "site", "terrain"],
  "x-groups": [
    { "key": "terrain", "label": "地形", "def": "terrain", "min": 1, "max": 10, "type_field": "type" },
    { "key": "zones", "label": "区域", "def": "zone", "min": 0, "max": 10, "type_field": "use" },
    { "key": "buildings", "label": "建筑", "def": "building", "min": 0, "max": 6, "type_field": "form" },
    { "key": "landmarks", "label": "地标", "def": "landmark", "min": 0, "max": 6, "type_field": "form" },
    { "key": "paths", "label": "路", "def": "path", "min": 0, "max": 6, "type_field": "style" },
    { "key": "water", "label": "水", "def": "water", "min": 0, "max": 3, "type_field": "type" },
    { "key": "spaces", "label": "空间", "def": "space", "min": 0, "max": 4, "type_field": "layout" },
    { "key": "relations", "label": "关系", "def": "relation", "min": 0, "max": 12, "type_field": "type" },
    { "key": "look", "label": "外观", "def": null, "min": 0, "max": 0, "fields": ["lighting", "palette", "mood"] }
  ],
  "x-defaults": {
    "terrain": {
      "hill": { "label": "山", "size_m": [100, 90], "top_layer": 4 },
      "ridge": { "label": "山脊", "size_m": [110, 34], "top_layer": 4, "orient": "E" },
      "slope_terraces": { "label": "坡上台地", "size_m": [80, 80], "steps": 4, "from_layer": 1 },
      "ring_terraces": { "label": "环台", "steps": 4, "from_layer": 1 },
      "plateau": { "label": "平台", "size_m": [24, 20], "layer": 2 },
      "cliff": { "label": "崖", "size_m": [50, 8], "layer": 4 },
      "valley": { "label": "谷", "size_m": [150, 18], "depth_layers": 2, "orient": "N" },
      "basin": { "label": "盆地", "size_m": [60, 50], "depth_layers": 1 },
      "pit": { "label": "坑", "size_m": [14, 14], "depth_layers": 2 },
      "island": { "label": "高台", "size_m": [30, 30], "layer": 3 }
    },
    "buildings": {
      "house": { "label": "民居", "size_m": [6, 4, 5], "floors": 1, "roof": "gable" },
      "stilt_house": { "label": "吊脚楼", "size_m": [6, 7, 5], "floors": 2, "roof": "gable" },
      "courtyard": { "label": "院落", "size_m": [16, 5, 16], "floors": 1, "roof": "gable" },
      "round_house": { "label": "圆楼", "size_m": [18, 9, 18], "floors": 3, "roof": "round" },
      "tower": { "label": "塔楼", "size_m": [6, 14, 6], "floors": 4, "roof": "pyramid" },
      "hall": { "label": "大殿", "size_m": [12, 8, 9], "floors": 1, "roof": "hip" },
      "pavilion": { "label": "亭", "size_m": [5, 5, 5], "floors": 1, "roof": "pyramid" },
      "gate": { "label": "门楼", "size_m": [8, 7, 3], "floors": 1, "roof": "gable" },
      "bridge": { "label": "桥", "size_m": [16, 5, 4], "floors": 1, "roof": "gable" },
      "stage": { "label": "戏台", "size_m": [10, 6, 8], "floors": 1, "roof": "hip" },
      "wall": { "label": "墙", "size_m": [20, 3, 1], "floors": 1, "roof": "none" },
      "well": { "label": "井", "size_m": [2, 1, 2], "floors": 1, "roof": "none" },
      "tree": { "label": "古树", "size_m": [7, 14, 7], "floors": 1, "roof": "none" },
      "statue": { "label": "石像", "size_m": [3, 5, 3], "floors": 1, "roof": "none" },
      "custom": { "label": "建筑", "size_m": [6, 5, 6], "floors": 1, "roof": "flat" }
    },
    "landmarks": {
      "tower": { "label": "鼓楼", "size_m": [7, 14, 7], "floors": 5, "roof": "pyramid", "place": { "rel": "top_of", "target": "site" } },
      "hall": { "label": "寺", "size_m": [10, 9, 9], "floors": 1, "roof": "hip", "place": { "rel": "top_of", "target": "site" } },
      "gate": { "label": "寨门", "size_m": [8, 7, 3], "floors": 1, "roof": "gable", "place": { "rel": "at_entry", "target": "site" } },
      "bridge": { "label": "风雨桥", "size_m": [18, 6, 5], "floors": 1, "roof": "gable", "place": { "rel": "center_of", "target": "site" } },
      "stage": { "label": "戏台", "size_m": [10, 6, 8], "floors": 1, "roof": "hip", "place": { "rel": "center_of", "target": "site" } },
      "pavilion": { "label": "亭", "size_m": [5, 5, 5], "floors": 1, "roof": "pyramid", "place": { "rel": "top_of", "target": "site" } },
      "tree": { "label": "神木", "size_m": [7, 16, 7], "floors": 1, "roof": "none", "place": { "rel": "center_of", "target": "site" } },
      "well": { "label": "古井", "size_m": [2.5, 1.2, 2.5], "floors": 1, "roof": "none", "place": { "rel": "center_of", "target": "site" } },
      "statue": { "label": "石像", "size_m": [3, 6, 3], "floors": 1, "roof": "none", "place": { "rel": "center_of", "target": "site" } },
      "round_house": { "label": "圆楼", "size_m": [20, 10, 20], "floors": 3, "roof": "round", "place": { "rel": "center_of", "target": "site" } },
      "house": { "label": "大屋", "size_m": [8, 5, 6], "floors": 2, "roof": "gable", "place": { "rel": "center_of", "target": "site" } },
      "stilt_house": { "label": "吊脚楼", "size_m": [7, 8, 6], "floors": 2, "roof": "gable", "place": { "rel": "edge_of", "target": "site" } },
      "courtyard": { "label": "大院", "size_m": [18, 6, 18], "floors": 1, "roof": "gable", "place": { "rel": "center_of", "target": "site" } },
      "wall": { "label": "寨墙", "size_m": [24, 4, 1.5], "floors": 1, "roof": "none", "place": { "rel": "edge_of", "target": "site" } },
      "custom": { "label": "地标", "size_m": [6, 8, 6], "floors": 1, "roof": "flat", "place": { "rel": "center_of", "target": "site" } }
    },
    "zones": {
      "housing": { "label": "民居", "density": 1 },
      "market": { "label": "集市", "density": 0.9 },
      "plaza": { "label": "广场", "density": 0 },
      "farm": { "label": "田", "density": 0 },
      "terrace_farm": { "label": "梯田", "density": 0 },
      "forest": { "label": "林子", "density": 1 },
      "temple": { "label": "寺院", "density": 0.35 },
      "dock": { "label": "码头", "density": 0.5 },
      "yard": { "label": "院子", "density": 0.6 },
      "ruins": { "label": "废墟", "density": 0.5 },
      "other": { "label": "区域", "density": 0.6 }
    },
    "paths": {
      "winding": { "label": "山路", "width_m": 2 },
      "stairs": { "label": "石阶", "width_m": 2.5 },
      "zigzag": { "label": "之字路", "width_m": 2 },
      "straight": { "label": "直路", "width_m": 3 },
      "bridge": { "label": "桥路", "width_m": 3 },
      "tunnel": { "label": "隧道", "width_m": 3 }
    },
    "water": {
      "stream": { "label": "溪", "width_m": 4 },
      "river": { "label": "河", "width_m": 9 },
      "pond": { "label": "池塘", "size_m": [18, 14] }
    },
    "spaces": {
      "chamber": { "label": "地下室", "size_m": 14 },
      "corridor": { "label": "地道", "size_m": 30 },
      "maze": { "label": "迷宫", "size_m": 40, "branching": "medium", "corridor_m": 2.5 },
      "galleries": { "label": "矿道", "size_m": 44, "branching": "medium", "corridor_m": 3 },
      "halls": { "label": "地宫", "size_m": 32 },
      "network": { "label": "溶洞", "size_m": 40, "branching": "medium" },
      "rooms": { "label": "房间", "size_m": 36 }
    },
    "relations": {
      "visible_from": {}, "faces": {}, "adjacent": {}, "behind": {}, "above": {}, "below": {}, "between": {}, "far_from": {}
    }
  },
  "properties": {
    "name": { "type": "string", "maxLength": 16, "x-ui": { "label": "名字", "kind": "text" } },
    "one_liner": { "type": "string", "maxLength": 80, "x-ui": { "label": "一句话", "kind": "text" } },
    "site": { "$ref": "#/definitions/site" },
    "terrain": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/definitions/terrain" } },
    "buildings": { "type": "array", "maxItems": 6, "items": { "$ref": "#/definitions/building" } },
    "zones": { "type": "array", "maxItems": 10, "items": { "$ref": "#/definitions/zone" } },
    "landmarks": { "type": "array", "maxItems": 6, "items": { "$ref": "#/definitions/landmark" } },
    "spawn": { "$ref": "#/definitions/spawn" },
    "paths": { "type": "array", "maxItems": 6, "items": { "$ref": "#/definitions/path" } },
    "water": { "type": "array", "maxItems": 3, "items": { "$ref": "#/definitions/water" } },
    "spaces": { "type": "array", "maxItems": 4, "items": { "$ref": "#/definitions/space" } },
    "relations": { "type": "array", "maxItems": 12, "items": { "$ref": "#/definitions/relation" } },
    "palette": { "type": "array", "maxItems": 8, "items": { "$ref": "#/definitions/palette_entry" }, "x-ui": { "label": "色板", "kind": "palette" } },
    "lighting": { "$ref": "#/definitions/lighting" },
    "mood": { "type": "array", "maxItems": 6, "items": { "type": "string", "maxLength": 8 }, "x-ui": { "label": "气氛", "kind": "tags" } },
    "locks": { "type": "array", "items": { "$ref": "#/definitions/id" }, "description": "人锁住的元素 id（换一批时不动）。只由界面写。", "x-ui": { "hidden": true } }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$", "description": "AI 起的英文小写短名，供引用" },
    "ref": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$", "description": "引用：site / spawn / 任何元素 id" },
    "label": { "type": "string", "minLength": 1, "maxLength": 12 },
    "dir": { "type": "string", "enum": ["C", "N", "NE", "E", "SE", "S", "SW", "W", "NW"] },
    "size2": { "type": "array", "items": { "type": "number", "minimum": 4, "maximum": 240 }, "minItems": 2, "maxItems": 2 },
    "size3": { "type": "array", "items": { "type": "number", "minimum": 0.5, "maximum": 80 }, "minItems": 3, "maxItems": 3 },
    "nudge": { "type": "array", "items": { "type": "number", "minimum": -60, "maximum": 60 }, "minItems": 2, "maxItems": 2, "description": "人在图上拖过的微调 [dx, dz]（米）。AI 不写。" },

    "site": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size_m": { "type": "number", "minimum": 80, "maximum": 240, "default": 140, "x-ui": { "label": "场地边长", "kind": "number", "step": 10, "unit": "m", "summary": true, "short": "{v} m 见方" } },
        "relief_layers": { "type": "integer", "minimum": 1, "maximum": 12, "default": 5, "x-ui": { "label": "总高差", "kind": "number", "step": 1, "unit": "层", "summary": true, "short": "高差 {v} 层" } },
        "layer_m": { "type": "number", "minimum": 2, "maximum": 6, "default": 3, "x-ui": { "label": "每层高", "kind": "number", "step": 0.5, "unit": "m", "summary": true, "short": "每层 {v} m" } }
      }
    },

    "at": {
      "type": "object",
      "additionalProperties": false,
      "description": "相对位置：of 的中心 + dir 方向 × dist × of 在该方向的半径。不是坐标。",
      "properties": {
        "of": { "$ref": "#/definitions/ref", "default": "site", "x-ui": { "label": "相对于", "kind": "ref", "ref": ["site", "terrain"] } },
        "dir": { "$ref": "#/definitions/dir", "default": "C", "x-ui": { "label": "方向", "kind": "dir", "options": { "C": "中", "N": "北", "NE": "东北", "E": "东", "SE": "东南", "S": "南", "SW": "西南", "W": "西", "NW": "西北" } } },
        "dist": { "type": "number", "minimum": 0, "maximum": 1.5, "default": 0.5, "x-ui": { "label": "离中心", "kind": "number", "step": 0.05, "min": 0, "max": 1.5, "unit": "× 半径" } }
      }
    },

    "terrain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/definitions/id", "x-ui": { "hidden": true } },
        "type": { "type": "string", "enum": ["hill", "ridge", "slope_terraces", "ring_terraces", "plateau", "cliff", "valley", "basin", "pit", "island"], "x-ui": { "label": "种类", "kind": "enum", "options": { "hill": "穹顶山", "ridge": "山脊", "slope_terraces": "坡上台地", "ring_terraces": "环台", "plateau": "平台", "cliff": "崖", "valley": "谷", "basin": "盆地", "pit": "坑", "island": "高台" } } },
        "label": { "$ref": "#/definitions/label", "x-ui": { "label": "名字", "kind": "text" } },
        "at": { "$ref": "#/definitions/at", "x-ui": { "label": "位置" } },
        "size_m": { "$ref": "#/definitions/size2", "description": "[长, 宽]（米）。谷 / 山脊 / 台地带：沿 orient 的长、横向的宽；崖 = [长, 厚]，厚夹在 4–12 m，前小后大时对调；平台 / 盆地 / 坑 / 高台没给 orient 时 = [东西, 南北]，若在别的块某一侧（at.dir 不是 C），长边顺着那一侧的边。", "x-ui": { "label": "尺寸", "kind": "pair", "step": 2, "unit": "m", "parts": ["长", "宽"], "ai_hint": "[长,宽]；崖=[长,厚] 厚4–12；平台/盆地没给orient=[东西,南北]，在别块某侧时长边顺着那条边", "when": { "type": ["hill", "ridge", "slope_terraces", "ring_terraces", "plateau", "cliff", "valley", "basin", "pit", "island"] } } },
        "orient": { "$ref": "#/definitions/dir", "x-ui": { "label": "朝向", "kind": "dir", "hint": "台地带：上坡方向；山脊 / 谷 / 崖：长轴方向", "when": { "type": ["slope_terraces", "ridge", "valley", "cliff", "plateau", "hill"] }, "options": { "N": "北", "NE": "东北", "E": "东", "SE": "东南", "S": "南", "SW": "西南", "W": "西", "NW": "西北" } } },
        "top_layer": { "type": "integer", "minimum": 1, "maximum": 12, "x-ui": { "label": "山顶高", "kind": "number", "step": 1, "unit": "层", "summary": true, "short": "顶 {v} 层", "when": { "type": ["hill", "ridge"] } } },
        "layer": { "type": "integer", "minimum": 0, "maximum": 12, "x-ui": { "label": "所在层", "kind": "number", "step": 1, "unit": "层", "summary": true, "short": "第 {v} 层", "when": { "type": ["plateau", "cliff", "island"] } } },
        "steps": { "type": "integer", "minimum": 2, "maximum": 10, "x-ui": { "label": "级数", "kind": "number", "step": 1, "unit": "级", "summary": true, "short": "{v} 级", "when": { "type": ["slope_terraces", "ring_terraces"] } } },
        "from_layer": { "type": "integer", "minimum": 0, "maximum": 10, "x-ui": { "label": "起始层", "kind": "number", "step": 1, "unit": "层", "summary": true, "short": "从 {v} 层起", "when": { "type": ["slope_terraces", "ring_terraces"] } } },
        "width_m": { "type": "number", "minimum": 5, "maximum": 30, "x-ui": { "label": "每级宽", "kind": "number", "step": 1, "unit": "m", "when": { "type": ["ring_terraces", "slope_terraces"] } } },
        "inverse": { "type": "boolean", "x-ui": { "label": "内低外高", "kind": "bool", "when": { "type": ["ring_terraces"] } } },
        "depth_layers": { "type": "integer", "minimum": 1, "maximum": 6, "x-ui": { "label": "深", "kind": "number", "step": 1, "unit": "层", "summary": true, "short": "深 {v} 层", "when": { "type": ["valley", "basin", "pit"] } } }
      }
    },

    "building": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "form"],
      "description": "建筑类型（不是一栋栋）：区域按它的 form 与尺寸生成房子",
      "properties": {
        "id": { "$ref": "#/definitions/id", "x-ui": { "hidden": true } },
        "label": { "$ref": "#/definitions/label", "x-ui": { "label": "名字", "kind": "text" } },
        "form": { "$ref": "#/definitions/form", "x-ui": { "label": "形制", "kind": "enum", "summary": true, "short": "{o}" } },
        "size_m": { "$ref": "#/definitions/size3", "x-ui": { "label": "尺寸", "kind": "triple", "step": 0.5, "unit": "m", "parts": ["宽", "高", "深"], "summary": true, "short": "{v0}×{v2} m" } },
        "floors": { "type": "integer", "minimum": 1, "maximum": 9, "x-ui": { "label": "层数", "kind": "number", "step": 1, "unit": "层", "summary": true, "short": "{v} 层" } },
        "roof": { "$ref": "#/definitions/roof", "x-ui": { "label": "屋顶", "kind": "enum" } }
      }
    },

    "form": { "type": "string", "enum": ["house", "stilt_house", "courtyard", "round_house", "tower", "hall", "pavilion", "gate", "bridge", "stage", "wall", "well", "tree", "statue", "custom"], "x-ui": { "options": { "house": "民居", "stilt_house": "吊脚楼", "courtyard": "院落", "round_house": "圆楼", "tower": "塔楼", "hall": "殿堂", "pavilion": "亭", "gate": "门", "bridge": "桥", "stage": "戏台", "wall": "墙", "well": "井", "tree": "树", "statue": "像", "custom": "自定" } } },
    "roof": { "type": "string", "enum": ["gable", "hip", "flat", "pyramid", "round", "none"], "x-ui": { "options": { "gable": "人字", "hip": "庑殿", "flat": "平顶", "pyramid": "攒尖", "round": "圆顶", "none": "无" } } },

    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "use", "on"],
      "properties": {
        "id": { "$ref": "#/definitions/id", "x-ui": { "hidden": true } },
        "label": { "$ref": "#/definitions/label", "x-ui": { "label": "名字", "kind": "text" } },
        "use": { "type": "string", "enum": ["housing", "market", "plaza", "farm", "terrace_farm", "forest", "temple", "dock", "yard", "ruins", "other"], "x-ui": { "label": "用途", "kind": "enum", "summary": true, "short": "{o}", "options": { "housing": "民居", "market": "集市", "plaza": "广场", "farm": "田", "terrace_farm": "梯田", "forest": "林子", "temple": "寺院", "dock": "码头", "yard": "院子", "ruins": "废墟", "other": "其它" } } },
        "on": { "$ref": "#/definitions/ref", "x-ui": { "label": "在哪", "kind": "ref", "ref": ["site", "terrain", "spaces"], "summary": true, "short": "在 {r}" } },
        "levels": {
          "oneOf": [
            { "type": "string", "enum": ["all", "low", "mid", "high"] },
            { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 12 }, "minItems": 1, "maxItems": 12 }
          ],
          "x-ui": { "label": "哪几层", "kind": "enum", "options": { "all": "全部", "low": "低处", "mid": "中间", "high": "高处" } }
        },
        "side": { "$ref": "#/definitions/dir", "x-ui": { "label": "哪一侧", "kind": "dir", "options": { "C": "不限", "N": "北", "NE": "东北", "E": "东", "SE": "东南", "S": "南", "SW": "西南", "W": "西", "NW": "西北" } } },
        "building": { "$ref": "#/definitions/ref", "x-ui": { "label": "建筑", "kind": "ref", "ref": ["buildings"], "summary": true, "short": "{r}" } },
        "density": { "type": "number", "minimum": 0, "maximum": 1.6, "x-ui": { "label": "密度", "kind": "number", "step": 0.1, "min": 0, "max": 1.6, "summary": true, "short": "密度 {v}" } }
      }
    },

    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rel"],
      "description": "相对放置：引擎按 rel 求候选点，按「不压路、不压房、关系成立更多」挑第一名",
      "properties": {
        "rel": { "type": "string", "enum": ["top_of", "center_of", "edge_of", "end_of", "beside", "behind", "between", "under", "above", "along", "at_entry"], "x-ui": { "label": "放在", "kind": "enum", "summary": true, "short": "{o}", "options": { "top_of": "顶上", "center_of": "中央", "edge_of": "边上", "end_of": "尽头", "beside": "旁边", "behind": "后面", "between": "之间", "under": "下面", "above": "上面", "along": "沿着", "at_entry": "入口处" } } },
        "target": {
          "oneOf": [ { "$ref": "#/definitions/ref" }, { "type": "array", "items": { "$ref": "#/definitions/ref" }, "minItems": 2, "maxItems": 2 } ],
          "default": "site",
          "x-ui": { "label": "目标", "kind": "ref", "ref": ["site", "spawn", "terrain", "zones", "landmarks", "paths", "water", "spaces"], "summary": true, "short": "{r}" }
        },
        "side": { "$ref": "#/definitions/dir", "x-ui": { "label": "哪一侧", "kind": "dir", "options": { "C": "不限", "N": "北", "NE": "东北", "E": "东", "SE": "东南", "S": "南", "SW": "西南", "W": "西", "NW": "西北" } } },
        "facing": { "type": "string", "pattern": "^([a-z][a-z0-9_]{0,31}|C|N|NE|E|SE|S|SW|W|NW)$", "description": "spawn / 元素 id / 方向", "x-ui": { "label": "朝向", "kind": "ref", "ref": ["spawn", "landmarks", "terrain", "zones"], "dirs": true } },
        "gap_m": { "type": "number", "minimum": 0, "maximum": 40, "x-ui": { "label": "间距", "kind": "number", "step": 1, "unit": "m" } },
        "nudge_m": { "$ref": "#/definitions/nudge", "x-ui": { "hidden": true } }
      }
    },

    "landmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "form", "place"],
      "properties": {
        "id": { "$ref": "#/definitions/id", "x-ui": { "hidden": true } },
        "label": { "$ref": "#/definitions/label", "x-ui": { "label": "名字", "kind": "text" } },
        "form": { "$ref": "#/definitions/form", "x-ui": { "label": "形制", "kind": "enum" } },
        "size_m": { "$ref": "#/definitions/size3", "x-ui": { "label": "尺寸", "kind": "triple", "step": 0.5, "unit": "m", "parts": ["宽", "高", "深"], "summary": true, "short": "高 {v1} m" } },
        "floors": { "type": "integer", "minimum": 1, "maximum": 9, "x-ui": { "label": "层数", "kind": "number", "step": 1, "unit": "层" } },
        "roof": { "$ref": "#/definitions/roof", "x-ui": { "label": "屋顶", "kind": "enum" } },
        "place": { "$ref": "#/definitions/place", "x-ui": { "label": "位置" } }
      }
    },

    "spawn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "$ref": "#/definitions/label", "x-ui": { "label": "名字", "kind": "text" } },
        "place": { "$ref": "#/definitions/place", "x-ui": { "label": "位置" } },
        "look_at": { "$ref": "#/definitions/ref", "x-ui": { "label": "第一眼看", "kind": "ref", "ref": ["landmarks", "terrain", "zones"], "summary": true, "short": "看 {r}" } }
      }
    },

    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to"],
      "properties": {
        "id": { "$ref": "#/definitions/id", "x-ui": { "hidden": true } },
        "label": { "$ref": "#/definitions/label", "x-ui": { "label": "名字", "kind": "text" } },
        "from": { "$ref": "#/definitions/ref", "x-ui": { "label": "从", "kind": "ref", "ref": ["spawn", "landmarks", "zones", "terrain", "water", "spaces", "paths"], "summary": true, "short": "{r} →" } },
        "to": { "$ref": "#/definitions/ref", "x-ui": { "label": "到", "kind": "ref", "ref": ["spawn", "landmarks", "zones", "terrain", "water", "spaces", "paths"], "summary": true, "short": "{r}" } },
        "via": { "type": "array", "maxItems": 4, "items": { "$ref": "#/definitions/ref" }, "x-ui": { "label": "经过", "kind": "refs", "ref": ["landmarks", "zones", "terrain", "water"] } },
        "style": { "type": "string", "enum": ["winding", "stairs", "zigzag", "straight", "bridge", "tunnel"], "x-ui": { "label": "走法", "kind": "enum", "summary": true, "short": "{o}", "options": { "winding": "顺坡绕", "stairs": "石阶", "zigzag": "之字", "straight": "直", "bridge": "桥", "tunnel": "隧道" } } },
        "width_m": { "type": "number", "minimum": 1, "maximum": 8, "x-ui": { "label": "路宽", "kind": "number", "step": 0.5, "unit": "m" } }
      }
    },

    "water": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/definitions/id", "x-ui": { "hidden": true } },
        "label": { "$ref": "#/definitions/label", "x-ui": { "label": "名字", "kind": "text" } },
        "type": { "type": "string", "enum": ["stream", "river", "pond"], "x-ui": { "label": "种类", "kind": "enum", "summary": true, "short": "{o}", "options": { "stream": "溪", "river": "河", "pond": "池塘" } } },
        "from": { "$ref": "#/definitions/at", "x-ui": { "label": "源头", "when": { "type": ["stream", "river"] } } },
        "to": { "$ref": "#/definitions/at", "x-ui": { "label": "流向", "when": { "type": ["stream", "river"] } } },
        "at": { "$ref": "#/definitions/at", "x-ui": { "label": "位置", "when": { "type": ["pond"] } } },
        "size_m": { "$ref": "#/definitions/size2", "x-ui": { "label": "尺寸", "kind": "pair", "step": 2, "unit": "m", "parts": ["长", "宽"], "when": { "type": ["pond"] } } },
        "width_m": { "type": "number", "minimum": 1, "maximum": 20, "x-ui": { "label": "宽", "kind": "number", "step": 0.5, "unit": "m", "summary": true, "short": "宽 {v} m", "when": { "type": ["stream", "river"] } } }
      }
    },

    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "label": { "$ref": "#/definitions/label" },
        "size": { "type": "string", "enum": ["s", "m", "l"], "default": "m", "x-ui": { "options": { "s": "小", "m": "中", "l": "大" } } }
      }
    },

    "space": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stratum", "layout"],
      "properties": {
        "id": { "$ref": "#/definitions/id", "x-ui": { "hidden": true } },
        "label": { "$ref": "#/definitions/label", "x-ui": { "label": "名字", "kind": "text" } },
        "stratum": { "type": "string", "enum": ["underground", "sky"], "x-ui": { "label": "在哪层", "kind": "enum", "summary": true, "short": "{o}", "options": { "underground": "地下", "sky": "天上" } } },
        "under": { "$ref": "#/definitions/ref", "x-ui": { "label": "在谁下面", "kind": "ref", "ref": ["site", "terrain", "zones", "landmarks"], "when": { "stratum": ["underground"] } } },
        "over": { "$ref": "#/definitions/ref", "x-ui": { "label": "在谁上面", "kind": "ref", "ref": ["site", "terrain", "zones", "landmarks", "water"], "when": { "stratum": ["sky"] } } },
        "depth_layers": { "type": "integer", "minimum": 1, "maximum": 6, "x-ui": { "label": "深", "kind": "number", "step": 1, "unit": "层", "summary": true, "short": "深 {v} 层", "when": { "stratum": ["underground"] } } },
        "height_layers": { "type": "integer", "minimum": 1, "maximum": 8, "x-ui": { "label": "高", "kind": "number", "step": 1, "unit": "层", "summary": true, "short": "高 {v} 层", "when": { "stratum": ["sky"] } } },
        "layout": { "type": "string", "enum": ["chamber", "corridor", "maze", "galleries", "halls", "network", "rooms"], "x-ui": { "label": "布局", "kind": "enum", "summary": true, "short": "{o}", "options": { "chamber": "单室", "corridor": "地道", "maze": "迷宫", "galleries": "矿道", "halls": "厅堂", "network": "洞穴网", "rooms": "按房间" } } },
        "size_m": { "type": "number", "minimum": 8, "maximum": 80, "x-ui": { "label": "大小", "kind": "number", "step": 2, "unit": "m", "summary": true, "short": "{v} m" } },
        "branching": { "type": "string", "enum": ["low", "medium", "high"], "x-ui": { "label": "岔路", "kind": "enum", "options": { "low": "少", "medium": "中", "high": "多" }, "when": { "layout": ["maze", "galleries", "network"] } } },
        "sublevels": { "type": "integer", "minimum": 1, "maximum": 3, "x-ui": { "label": "内部层数", "kind": "number", "step": 1, "unit": "层", "summary": true, "short": "{v} 层", "when": { "layout": ["maze", "galleries", "network", "halls", "corridor", "chamber"] } } },
        "corridor_m": { "type": "number", "minimum": 1.5, "maximum": 6, "x-ui": { "label": "走廊宽", "kind": "number", "step": 0.5, "unit": "m", "when": { "layout": ["maze", "galleries", "corridor", "network", "halls", "rooms"] } } },
        "height_m": { "type": "number", "minimum": 2.2, "maximum": 12, "description": "每层净高（米）；不写按布局默认", "x-ui": { "label": "净高", "kind": "number", "step": 0.5, "unit": "m" } },
        "rooms": { "type": "array", "maxItems": 12, "items": { "$ref": "#/definitions/room" }, "x-ui": { "label": "房间", "kind": "rooms", "when": { "layout": ["rooms"] } } },
        "links": { "type": "array", "maxItems": 24, "items": { "type": "array", "items": { "$ref": "#/definitions/ref" }, "minItems": 2, "maxItems": 2 }, "description": "房间连线；\"entry\" 是从地面下来的入口", "x-ui": { "label": "连接", "kind": "links", "when": { "layout": ["rooms"] } } },
        "connect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "via": { "type": "string", "enum": ["stairs", "ladder", "well", "shaft", "elevator", "rope_bridge", "ramp"], "x-ui": { "label": "怎么连", "kind": "enum", "options": { "stairs": "楼梯", "ladder": "梯子", "well": "井", "shaft": "竖井", "elevator": "升降台", "rope_bridge": "索桥", "ramp": "坡道" } } },
            "from": { "$ref": "#/definitions/ref", "x-ui": { "label": "从哪下 / 上", "kind": "ref", "ref": ["site", "spawn", "terrain", "zones", "landmarks", "spaces"] } }
          },
          "x-ui": { "label": "连接" }
        },
        "offset_m": { "$ref": "#/definitions/nudge", "x-ui": { "hidden": true } },
        "layout_seed": { "type": "integer", "minimum": 0, "maximum": 2147483647, "description": "「换一个」换的内部布局种子（人点的，AI 不写）", "x-ui": { "hidden": true } }
      }
    },

    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "a", "b"],
      "properties": {
        "type": { "type": "string", "enum": ["visible_from", "faces", "adjacent", "behind", "above", "below", "between", "far_from"], "x-ui": { "label": "关系", "kind": "enum", "options": { "visible_from": "从…看得见", "faces": "朝向", "adjacent": "挨着", "behind": "在…后面", "above": "在…上方", "below": "在…下方", "between": "在…之间", "far_from": "远离" } } },
        "a": { "$ref": "#/definitions/ref", "x-ui": { "label": "谁", "kind": "ref", "ref": ["spawn", "landmarks", "zones", "terrain", "spaces", "water", "paths"] } },
        "b": { "$ref": "#/definitions/ref", "x-ui": { "label": "对谁", "kind": "ref", "ref": ["spawn", "landmarks", "zones", "terrain", "spaces", "water", "paths"] } },
        "c": { "$ref": "#/definitions/ref", "x-ui": { "label": "和谁（之间）", "kind": "ref", "ref": ["spawn", "landmarks", "zones", "terrain", "spaces", "water", "paths"], "when": { "type": ["between"] } } }
      }
    },

    "palette_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "hex"],
      "properties": {
        "role": { "type": "string", "maxLength": 16, "x-ui": { "label": "角色", "kind": "text" } },
        "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "x-ui": { "label": "颜色", "kind": "color" } },
        "note": { "type": "string", "maxLength": 12, "x-ui": { "label": "说明", "kind": "text" } }
      }
    },

    "lighting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "time_of_day": { "type": "string", "enum": ["dawn", "morning", "noon", "afternoon", "dusk", "night", "overcast"], "x-ui": { "label": "时段", "kind": "enum", "summary": true, "short": "{o}", "options": { "dawn": "清晨", "morning": "上午", "noon": "正午", "afternoon": "下午", "dusk": "傍晚", "night": "夜", "overcast": "阴天" } } }
      }
    },

    "op_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "id", "field", "value"],
      "description": "改一个字段：id 是元素 id，或 site / spawn / lighting / plan（根上的 name / one_liner / mood / palette）；field 可以是嵌套路径（place.rel、at.dir、connect.via）",
      "properties": {
        "op": { "const": "set" },
        "id": { "$ref": "#/definitions/ref" },
        "field": { "type": "string", "pattern": "^[a-z_]+(\\.[a-z_]+)*$" },
        "value": {}
      }
    },
    "op_add": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "group", "value"],
      "description": "加一项：value 必须通过该组的 schema",
      "properties": {
        "op": { "const": "add" },
        "group": { "type": "string", "enum": ["terrain", "buildings", "zones", "landmarks", "paths", "water", "spaces", "relations"] },
        "value": { "type": "object" }
      }
    },
    "op_remove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "id"],
      "description": "删一项：引用它的东西本地降级（改指 site 或删掉那条关系）；关系用 \"rel:<序号>\" 删",
      "properties": {
        "op": { "const": "remove" },
        "id": { "type": "string" }
      }
    },
    "op": { "oneOf": [ { "$ref": "#/definitions/op_set" }, { "$ref": "#/definitions/op_add" }, { "$ref": "#/definitions/op_remove" } ] },
    "ops": { "type": "array", "maxItems": 16, "items": { "$ref": "#/definitions/op" } },
    "revise": {
      "type": "object",
      "description": "AI 改动（revise）的回复（docs/05 §5）",
      "required": ["understood", "ops"],
      "properties": {
        "understood": { "type": "boolean" },
        "restatement": { "type": "string", "maxLength": 60 },
        "ops": { "$ref": "#/definitions/ops" },
        "question": { "type": ["string", "null"] },
        "ask_to_point": { "type": "boolean" }
      }
    }
  }
}
