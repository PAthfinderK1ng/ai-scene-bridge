        "stratum": { "type": "string", "enum": ["underground", "sky"], "x-ui": { "label": "在哪层", "kind": "enum", "summary": true, "short": "{o}", "options": { "underground": "地下", "sky": "天上" }, "when": { "type": ["space"] } } },
        "under": { "$ref": "#/definitions/ref", "x-ui": { "label": "在谁下面", "kind": "ref", "ref": ["site", "terrain", "nodes"], "when": { "stratum": ["underground"] } } },
        "over": { "$ref": "#/definitions/ref", "x-ui": { "label": "在谁上面", "kind": "ref", "ref": ["site", "terrain", "nodes"], "when": { "stratum": ["sky"] } } },
        "depth_m": { "type": "number", "minimum": 2, "maximum": 80, "description": "空间顶板在地面以下多深 / 水深", "x-ui": { "label": "深", "kind": "number", "step": 1, "unit": "m", "summary": true, "short": "深 {v} m", "when": { "type": ["space", "water"] } } },
        "layout": { "type": "string", "enum": ["chamber", "corridor", "maze", "galleries", "halls", "network", "rooms"], "x-ui": { "label": "布局", "kind": "enum", "summary": true, "short": "{o}", "options": { "chamber": "单室", "corridor": "地道", "maze": "迷宫", "galleries": "矿道", "halls": "厅堂", "network": "洞穴网", "rooms": "按房间" }, "when": { "type": ["space"] } } },
        "branching": { "type": "string", "enum": ["low", "medium", "high"], "x-ui": { "label": "岔路", "kind": "enum", "options": { "low": "少", "medium": "中", "high": "多" }, "when": { "layout": ["maze", "galleries", "network"] } } },
        "sublevels": { "type": "integer", "minimum": 1, "maximum": 3, "x-ui": { "label": "内部层数", "kind": "number", "step": 1, "unit": "层", "summary": true, "short": "{v} 层", "when": { "type": ["space"] } } },
        "corridor_m": { "type": "number", "minimum": 1.5, "maximum": 6, "x-ui": { "label": "走廊宽", "kind": "number", "step": 0.5, "unit": "m", "when": { "layout": ["maze", "galleries", "corridor", "network", "halls", "rooms"] } } },
        "height_m": { "type": "number", "minimum": 2.2, "maximum": 12, "description": "空间每层净高", "x-ui": { "label": "净高", "kind": "number", "step": 0.5, "unit": "m", "when": { "type": ["space"] } } },
        "rooms": { "type": "array", "maxItems": 12, "items": { "$ref": "#/definitions/room" }, "x-ui": { "label": "房间", "kind": "rooms", "when": { "layout": ["rooms"] } } },
        "links": { "type": "array", "maxItems": 24, "items": { "type": "array", "items": { "$ref": "#/definitions/ref" }, "minItems": 2, "maxItems": 2 }, "description": "房间连线；\"entry\" 是入口", "x-ui": { "label": "连接", "kind": "links", "when": { "layout": ["rooms"] } } },
        "connect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "via": { "type": "string", "enum": ["stairs", "ladder", "well", "shaft", "elevator", "rope_bridge", "ramp"], "x-ui": { "label": "怎么连", "kind": "enum", "options": { "stairs": "楼梯", "ladder": "梯子", "well": "井", "shaft": "竖井", "elevator": "升降台", "rope_bridge": "索桥", "ramp": "坡道" } } },
            "from": { "$ref": "#/definitions/ref", "x-ui": { "label": "从哪下 / 上", "kind": "ref", "ref": ["site", "spawn", "nodes", "terrain"] } }
          },
          "x-ui": { "label": "连接", "when": { "type": ["space"] } }
        },
        "layout_seed": { "type": "integer", "minimum": 0, "maximum": 2147483647, "description": "「换一个」换的内部布局种子（人点的，AI 不写）", "x-ui": { "hidden": true } }
      }
    },

    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "label": { "$ref": "#/definitions/label" },
        "size": { "type": "string", "enum": ["s", "m", "l"], "default": "m", "x-ui": { "options": { "s": "小", "m": "中", "l": "大" } } }
      }
    },

    "spawn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "$ref": "#/definitions/label", "x-ui": { "label": "名字", "kind": "text" } },
        "at": { "$ref": "#/definitions/anchor", "default": "site.S", "x-ui": { "label": "在哪", "kind": "anchor", "ref": ["site", "terrain", "nodes"], "summary": true, "short": "@{r}" } },
        "offset_m": { "$ref": "#/definitions/offset", "x-ui": { "label": "偏移", "kind": "offset", "step": 1, "unit": "m" } },
        "look_at": { "$ref": "#/definitions/ref", "x-ui": { "label": "第一眼看", "kind": "ref", "ref": ["nodes", "terrain"], "summary": true, "short": "看 {r}" } }
      }
    },

    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "a", "b"],
      "properties": {
        "type": { "type": "string", "enum": ["visible_from", "reachable", "adjacent", "above", "below", "behind", "between", "far_from", "faces"],
          "x-ui": { "label": "关系", "kind": "enum", "options": { "visible_from": "从…看得见", "reachable": "从…走得到", "adjacent": "挨着", "above": "在…上方", "below": "在…下方", "behind": "在…后面", "between": "在…之间", "far_from": "远离", "faces": "朝向" } } },
        "a": { "$ref": "#/definitions/ref", "x-ui": { "label": "谁", "kind": "ref", "ref": ["spawn", "nodes", "terrain"] } },
        "b": { "$ref": "#/definitions/ref", "x-ui": { "label": "对谁", "kind": "ref", "ref": ["spawn", "nodes", "terrain"] } },
        "c": { "$ref": "#/definitions/ref", "x-ui": { "label": "和谁（之间）", "kind": "ref", "ref": ["spawn", "nodes", "terrain"], "when": { "type": ["between"] } } }
      }
    },

    "palette_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "hex"],
      "properties": {
        "role": { "type": "string", "maxLength": 16, "x-ui": { "label": "角色", "kind": "text" } },
        "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "x-ui": { "label": "颜色", "kind": "color" } },
        "note": { "type": "string", "maxLength": 12, "x-ui": { "label": "说明", "kind": "text" } }
      }
    },

    "lighting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "time_of_day": { "type": "string", "enum": ["dawn", "morning", "noon", "afternoon", "dusk", "night", "overcast"], "x-ui": { "label": "时段", "kind": "enum", "summary": true, "short": "{o}", "options": { "dawn": "清晨", "morning": "上午", "noon": "正午", "afternoon": "下午", "dusk": "傍晚", "night": "夜", "overcast": "阴天" } } }
      }
    },

    "op_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "id", "field", "value"],
      "description": "改一个字段：id 是节点 / 地形操作 id（树里任何深度），id[k] 改单个实例（写进 repeat 的 overrides），或 site / spawn / lighting / plan（根上的 name / concept / mood / palette）；field 可以是嵌套路径（connect.via、size_m）。value 为 null 表示删掉该字段",
      "properties": {
        "op": { "const": "set" },
        "id": { "$ref": "#/definitions/ref" },
        "field": { "type": "string", "pattern": "^[a-z_]+(\\.[a-z_0-9]+)*$" },
        "value": {}
      }
    },
    "op_add": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "to", "value"],
      "description": "加一项：to = root（根节点）/ terrain（地形操作）/ relations / marks（人画的标记，只由界面加）/ <group 或带 children 的节点 id>（加成它的子节点）；value 按对应定义校验；index 可选（插到第几个）",
      "properties": {
        "op": { "const": "add" },
        "to": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
        "index": { "type": "integer", "minimum": 0, "maximum": 64 },
        "value": { "type": "object" }
      }
    },
    "op_remove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "id"],
      "description": "删一项：节点（连同子树）/ 地形操作 / 标记 / 单个实例 id[k]（写进 repeat 的 skip）/ 关系 \"rel:<序号>\"；引用它的东西本地降级（锚点改到它的父组或 site，连接去掉）",
      "properties": {
        "op": { "const": "remove" },
        "id": { "type": "string" }
      }
    },
    "op": { "oneOf": [ { "$ref": "#/definitions/op_set" }, { "$ref": "#/definitions/op_add" }, { "$ref": "#/definitions/op_remove" } ] },
    "ops": { "type": "array", "maxItems": 16, "items": { "$ref": "#/definitions/op" } },
    "revise": {
      "type": "object",
      "description": "AI 改动（revise）的回复（docs/06 §3）：ops 作用在程序树上",
      "required": ["understood", "ops"],
      "properties": {
        "understood": { "type": "boolean" },
        "restatement": { "type": "string", "maxLength": 60 },
        "ops": { "$ref": "#/definitions/ops" },
        "question": { "type": ["string", "null"] },
        "ask_to_point": { "type": "boolean" }
      }
    }
  }
}
